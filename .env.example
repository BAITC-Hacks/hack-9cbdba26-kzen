# Скопируйте в .env: cp .env.example .env
# Все настройки читаются pydantic-settings. Переменные окружения важнее файла.

# --- данные партнёра ---
# Каталог с подпапками поставщиков (IEK, Systeme electric) и xlsx внутри
DATA_DIR=data

# Срок поставки и цикл пересмотра настраиваются в интерфейсе перед расчётом.

# --- кэш ---
# memory | redis (redis нужен только при нескольких воркерах)
CACHE_BACKEND=memory
CACHE_TTL=300
REDIS_URL=redis://localhost:6379/0

# --- текстовые объяснения (необязательно) ---
# none | template | openai
# openai формулирует обоснование словами; числа всегда приходят из расчёта
NARRATOR_BACKEND=template
OPENAI_API_KEY=
# Адаптер говорит по протоколу OpenAI Chat Completions, поэтому провайдер — это адрес и модель:
#   OpenAI: https://api.openai.com/v1 + gpt-4o-mini, ключ sk-...
#   NVIDIA NIM: https://integrate.api.nvidia.com/v1 + meta/llama-3.3-70b-instruct, ключ nvapi-...
#   Groq: https://api.groq.com/openai/v1 + llama-3.3-70b-versatile
#   локально (Ollama): http://localhost:11434/v1 + имя модели, ключ — любая строка
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
NARRATOR_TIMEOUT=8.0
NARRATOR_CACHE_TTL=3600
DOMAIN_HINT=закуп электротехники, пополнение склада дистрибьютора

# --- прочее ---
LOG_LEVEL=INFO
LOG_JSON=true
DEBUG=false
